// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Models

model User {
  id         String     @id @default(uuid())
  email      String     @unique
  full_name  String
  password   String
  status     UserStatus @default(PENDING)
  created_at DateTime   @default(now())
  image      String?

  role                 Role
  stock_movements      StockMovement[]
  sales                Sale[]
  invoices             Invoice[]
  userActivationTokens UserActivationToken[]
  resetPasswordTokens  ResetPasswordToken[]

  @@map("users")
}

model Customer {
  id         String   @id @default(uuid())
  full_name  String
  phone      String   @unique
  email      String?
  address    String?
  created_at DateTime @default(now())

  sales   Sale[]
  invoices Invoice[]

  @@map("customers")
}

model Product {
  id            String       @id @default(uuid())
  name          String
  sku           String       @unique
  category      Category
  description   String?
  unit_price    Decimal      @default(0.00) @db.Decimal(12, 2)
  unit          String
  tracking_type TrackingType
  reorder_level Int          @default(0)
  is_active     Boolean      @default(true)
  stock_movements StockMovement[]
  sale_items      SaleItem[]
  invoice_items   InvoiceItem[]
  vehicles        Vehicle[]

  @@map("products")
}

model Vehicle {
  id          String     @id @default(uuid())
  product_id  String
  vin         String     @unique
  color       String?
  status      VehicleStatus
  created_at  DateTime   @default(now())

  product             Product             @relation(fields: [product_id], references: [id])
  stock_movement      StockMovement[]
  sale_items          SaleItem[]

  @@map("vehicles")
}

model StockMovement {
  id           String              @id @default(uuid())
  product_id   String
  vehicle_id   String?
  quantity     Int
  type         StockMovementType
  reason       StockMovementReason
  performed_by String
  created_at   DateTime            @default(now())

  product Product            @relation(fields: [product_id], references: [id])
  vehicle Vehicle?           @relation(fields: [vehicle_id], references: [id])
  user    User               @relation(fields: [performed_by], references: [id])

  @@map("stock_movements")
}

model Sale {
  id               String        @id @default(uuid())
  sale_number      String        @unique
  customer_id      String
  created_by       String
  status           SaleStatus
  payment_status   PaymentStatus @default(PENDING)
  due_date         DateTime?
  created_at       DateTime      @default(now())

  customer   Customer   @relation(fields: [customer_id], references: [id])
  user       User       @relation(fields: [created_by], references: [id])
  sale_items SaleItem[]
  payments   Payment[]

  @@map("sales")
}

model Invoice {
  id             String        @id @default(uuid())
  invoice_number String        @unique
  customer_id    String
  created_by     String
  status         InvoiceStatus @default(PENDING)
  total_amount   Decimal       @default(0.00) @db.Decimal(12, 2)
  created_at     DateTime      @default(now())

  customer Customer    @relation(fields: [customer_id], references: [id])
  user     User        @relation(fields: [created_by], references: [id])
  items    InvoiceItem[]

  @@map("invoices")
}

model InvoiceItem {
  id         String  @id @default(uuid())
  invoice_id String
  product_id String
  quantity   Int
  unit_price Decimal @db.Decimal(12, 2)

  invoice Invoice  @relation(fields: [invoice_id], references: [id])
  product Product @relation(fields: [product_id], references: [id])

  @@map("invoice_items")
}

model SaleItem {
  id         String  @id @default(uuid())
  sale_id    String
  product_id String
  vehicle_id String?
  quantity   Int
  unit_price Decimal @db.Decimal(12, 2)

  sale    Sale    @relation(fields: [sale_id], references: [id])
  product Product @relation(fields: [product_id], references: [id])
  vehicle Vehicle? @relation(fields: [vehicle_id], references: [id])

  @@map("sale_items")
}

model Payment {
  id         String        @id @default(uuid())
  sale_id    String
  amount     Decimal       @db.Decimal(12, 2)
  method     PaymentMethod
  notes      String?
  created_at DateTime      @default(now())

  sale Sale @relation(fields: [sale_id], references: [id])

  @@map("payments")
}

model UserActivationToken {
  id         String   @id @default(uuid())
  user_id    String
  token      String   @unique
  expired_at DateTime @default(now())
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id])

  @@map("user_activation_tokens")
}

model ResetPasswordToken {
  id         String   @id @default(uuid())
  user_id    String
  token      String   @unique
  expired_at DateTime @default(now())
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id])

  @@map("reset_password_tokens")
}

model Job {
  id          String    @id @default(uuid())
  type        String
  payload     Json
  status      JobStatus @default(PENDING)
  retryCount  Int       @default(0)
  maxRetries  Int       @default(3)
  lastError   String?
  scheduledAt DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@map("jobs")
}

// Enums
enum UserStatus {
  PENDING
  ACTIVE
  INACTIVE
}

enum Role {
  ADMIN
  EDITOR
  VIEWER
}

enum TrackingType {
  SERIAL
  BATCH
}

enum Category {
  HEAVY_DUTY @map("heavy_duty")
  FERTILIZER @map("fertilizer")
  PARTS      @map("parts")
  TRUCK_HEAD @map("truck_head")
  TIPPER     @map("tipper")
  TRACTOR    @map("tractor")
  CAR        @map("car")
}

enum VehicleStatus {
  AVAILABLE
  SOLD
  DAMAGED
}

enum StockMovementType {
  IN
  OUT
}

enum StockMovementReason {
  PURCHASE
  SALE
  DAMAGE
  ADJUSTMENT
}

enum SaleStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  MOBILE_MONEY
}

enum PaymentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
}

enum InvoiceStatus {
  PENDING
  PAID
  CANCELLED
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Lead {
  id                  String     @id @default(uuid())
  full_name           String
  phone               String
  product_of_interest String?
  message             String?
  source              String?
  created_at          DateTime   @default(now())
  updated_at          DateTime   @updatedAt

  @@map("leads")
}
